###Relational
Database store::db
(
)


###Connection
RelationalDatabaseConnection connection::relational::DB2Static
{
  store: store::db;
  type: DB2;
  specification: Static
  {
    name: 'db2Db';
    host: 'db2.host';
    port: 50000;
  };
  auth: UserNamePassword
  {
    baseVaultReference: 'base/';
    userNameVaultReference: 'user';
    passwordVaultReference: 'pwd';
  };
}

