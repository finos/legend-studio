RelationalDatabaseConnection connection::relational::RedshiftConnection
{
  store: store::db;
  type: Redshift;
  specification: Redshift
  {
    host: 'myDBHost';
    port: 5439;
    name: 'database1';
    region: 'us-east-1';
    clusterID: 'cluster';
    endpointURL: 'http://www.example.com';
  };
  auth: UserNamePassword
  {
    userNameVaultReference: 'user';
    passwordVaultReference: 'pwd';
  };
}

RelationalDatabaseConnection connection::relational::RedshiftDelegatedKerberos
{
  store: store::db;
  type: Redshift;
  specification: Redshift
  {
    host: 'otherHost';
    port: 1234;
    name: 'database2';
    region: 'east';
    clusterID: 'cluster2';
    endpointURL: 'https://redshift.example.com';
  };
  auth: DelegatedKerberos;
}

RelationalDatabaseConnection connection::relational::SpannerWithProxy
{
  store: store::db;
  type: Spanner;
  specification: Spanner
  {
    projectId: 'spanner-emulator-test-1';
    instanceId: 'test-instance-1';
    databaseId: 'test-db';
    proxyHost: 'localhost';
    proxyPort: 9010;
  };
  auth: GCPApplicationDefaultCredentials;
}

RelationalDatabaseConnection connection::relational::SpannerDelegatedKerberos
{
  store: store::db;
  type: Spanner;
  specification: Spanner
  {
    projectId: 'spanner-emulator-test-1';
    instanceId: 'test-instance-1';
    databaseId: 'test-db';
  };
  auth: DelegatedKerberos;
}

RelationalDatabaseConnection connection::relational::SpannerWorkloadIdentityScopes
{
  store: store::db;
  type: Spanner;
  specification: Spanner
  {
    projectId: 'spanner-emulator-test-1';
    instanceId: 'test-instance-1';
    databaseId: 'test-db';
  };
  auth: GCPWorkloadIdentityFederation
  {
    serviceAccountEmail: 'name';
    additionalGcpScopes: [
      'gcpScope',
      'anotherGcpScope'
      ];
  };
}
