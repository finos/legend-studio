###Relational
Database store::db
(
)


###Connection
RelationalDatabaseConnection connection::relational::EmbeddedH2Connection
{
  store: store::db;
  type: H2;
  specification: EmbeddedH2
  {
    name: 'myDb';
    directory: './h2/data';
    autoServerMode: true;
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection connection::relational::EmbeddedH2ConnectionNoAutoServer
{
  store: store::db;
  type: H2;
  specification: EmbeddedH2
  {
    name: 'otherDb';
    directory: '/tmp/h2';
    autoServerMode: false;
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection connection::relational::SqlServerDelegatedKerberos
{
  store: store::db;
  type: SqlServer;
  specification: Static
  {
    name: 'name';
    host: 'host';
    port: 1433;
  };
  auth: DelegatedKerberos;
}

RelationalDatabaseConnection connection::relational::SqlServerDelegatedKerberosWithPrincipal
{
  store: store::db;
  type: SqlServer;
  specification: Static
  {
    name: 'name';
    host: 'host';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'MSSQLSvc/host.example.com@EXAMPLE.COM';
  };
}

RelationalDatabaseConnection connection::relational::PostgresUserNamePassword
{
  store: store::db;
  type: Postgres;
  specification: Static
  {
    name: 'myDatabase';
    host: 'myHost.com';
    port: 5432;
  };
  auth: UserNamePassword
  {
    userNameVaultReference: 'user';
    passwordVaultReference: 'pwd';
  };
}

RelationalDatabaseConnection connection::relational::PostgresDelegatedKerberos
{
  store: store::db;
  type: Postgres;
  timezone: 'UTC';
  quoteIdentifiers: true;
  specification: Static
  {
    name: 'myDatabase';
    host: 'myHost.com';
    port: 5432;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'postgres/myHost.com@EXAMPLE.COM';
  };
  queryTimeOutInSeconds: 60;
}

