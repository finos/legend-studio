RelationalDatabaseConnection connection::relational::SybaseOAuth
{
  store: store::db;
  type: Sybase;
  specification: Static
  {
    name: 'sybaseDb';
    host: 'sybase.host';
    port: 5000;
  };
  auth: OAuth
