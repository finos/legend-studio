RelationalDatabaseConnection connection::relational::SnowflakeLocalMode
{
  store: store::db;
  type: Snowflake;
  mode: local;
}

RelationalDatabaseConnection connection::relational::SnowflakeLocalModeWithOptions
{
  store: store::db;
  type: Snowflake;
  timezone: 'America/New_York';
  quoteIdentifiers: true;
  mode: local;
  queryTimeOutInSeconds: 120;
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'PUBLIC'; to: 'DEV';}
      ];
    }
  ];
  queryGenerationConfigs: [
    GenerationFeaturesConfig
    {
      enabled: [];
      disabled: ['REMOVE_UNION_OR_JOINS'];
    }
  ];
}
