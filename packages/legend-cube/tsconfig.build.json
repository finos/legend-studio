{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "build/prod.tsbuildinfo",
    // No ambient types at all: any browser or Node global used outside tests fails the build
    "types": []
  },
  "exclude": [
    "src/**/__tests__/**/*.*",
    "src/**/__test-utils__/**/*.*",
    "src/**/__mocks__/**/*.*"
  ]
}
